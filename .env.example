# Configurações do Supabase (Plano Gratuito)
# Obtenha em: https://supabase.com -> Seu Projeto -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Integração com API de Consulta de CPF (Opção B - Provedores como Infosimples / Hub)
# Opcional: sem token, o sistema opera automaticamente no modo de homologação/simulação cadastral
CPF_API_TOKEN=
CPF_API_URL=
